{
  "name": "itu-audio-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "api": "bash scripts/api.sh",
    "dev:all": "node scripts/dev.mjs",
    "build": "node --experimental-strip-types scripts/build-flow-diagrams.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "node --test --experimental-strip-types tests/model.test.ts tests/ecnr-evaluation.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
