set(ITU_SPEEXDSP_SOURCE_DIR "${CMAKE_SOURCE_DIR}/build/deps/speexdsp-1.2.1" CACHE PATH "Required official SpeexDSP source for quality-8 sample-rate conversion")
if(NOT ITU_SPEEXDSP_SOURCE_DIR OR NOT EXISTS "${ITU_SPEEXDSP_SOURCE_DIR}/libspeexdsp/resample.c")
  message(FATAL_ERROR "SpeexDSP is required for fullband-safe 16/24/48 kHz conversion. Run python3 cpp/tools/fetch_speexdsp.py and set ITU_SPEEXDSP_SOURCE_DIR to its output.")
endif()
if(ITU_SPEEXDSP_SOURCE_DIR)
  set(sp "${ITU_SPEEXDSP_SOURCE_DIR}")
  if(NOT EXISTS "${sp}/libspeexdsp/preprocess.c")
    message(FATAL_ERROR "SpeexDSP source missing")
  endif()
  set(INCLUDE_STDINT "#include <stdint.h>")
  set(SIZE16 int16_t)
  set(USIZE16 uint16_t)
  set(SIZE32 int32_t)
  set(USIZE32 uint32_t)
  configure_file("${sp}/include/speex/speexdsp_config_types.h.in"
    "${CMAKE_BINARY_DIR}/speex-generated/speex/speexdsp_config_types.h" @ONLY)
  set(sp_sources preprocess.c mdf.c fftwrap.c filterbank.c smallft.c resample.c)
  list(TRANSFORM sp_sources PREPEND "${sp}/libspeexdsp/")
  add_library(itu_speexdsp STATIC ${sp_sources})
  target_include_directories(itu_speexdsp PUBLIC "${sp}/include" "${CMAKE_BINARY_DIR}/speex-generated/speex")
  target_compile_definitions(itu_speexdsp PRIVATE FLOATING_POINT USE_SMALLFT VAR_ARRAYS "EXPORT=")
  option(ITU_SPEEX_RESAMPLER_NEON "Use upstream AArch64 NEON quality-8 resampling kernels" ON)
  if(ITU_SPEEX_RESAMPLER_NEON AND (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64" OR ANDROID_ABI STREQUAL "arm64-v8a"))
    target_compile_definitions(itu_speexdsp PRIVATE USE_NEON)
  endif()
  set_target_properties(itu_speexdsp PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_link_libraries(itu_audio PRIVATE itu_speexdsp m)
  target_compile_definitions(itu_audio PRIVATE ITU_HAS_SPEEXDSP=1)
  install(FILES "${sp}/COPYING" DESTINATION share/itu-audio/licenses RENAME SpeexDSP-COPYING)
endif()
