set(ITU_RNNOISE_SOURCE_DIR "" CACHE PATH "Optional official RNNoise source with downloaded model data")
if(ITU_RNNOISE_SOURCE_DIR)
  set(rn "${ITU_RNNOISE_SOURCE_DIR}")
  foreach(path include/rnnoise.h src/rnnoise_data_little.c COPYING)
    if(NOT EXISTS "${rn}/${path}")
      message(FATAL_ERROR "RNNoise source/model missing: ${rn}/${path}")
    endif()
  endforeach()
  file(SHA256 "${rn}/src/rnnoise_data_little.c" rn_model_sha)
  if(NOT rn_model_sha STREQUAL "eea1aa6fd8726d161876508a6f7d79022bf6ec82508660b4c1ac27c4f9b76c04")
    message(FATAL_ERROR "RNNoise little model differs from tested weights")
  endif()
  set(rn_sources denoise.c rnn.c pitch.c kiss_fft.c celt_lpc.c nnet.c
    nnet_default.c parse_lpcnet_weights.c rnnoise_data_little.c rnnoise_tables.c)
  list(TRANSFORM rn_sources PREPEND "${rn}/src/")
  add_library(itu_rnnoise STATIC ${rn_sources})
  target_include_directories(itu_rnnoise PUBLIC "${rn}/include" PRIVATE "${rn}/src")
  target_compile_definitions(itu_rnnoise PRIVATE RNNOISE_BUILD)
  set_target_properties(itu_rnnoise PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_link_libraries(itu_audio PRIVATE itu_rnnoise m)
  target_compile_definitions(itu_audio PRIVATE ITU_HAS_RNNOISE=1)
  install(FILES "${rn}/COPYING" DESTINATION share/itu-audio/licenses RENAME RNNoise-COPYING)
endif()
